<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>LakeSpeak.Genie</PackageId>
    <Description>A focused .NET client for the Databricks Genie Conversation API: stateful conversations, generated SQL, query results, and typed failures. Independent open-source project, not affiliated with Databricks.</Description>
    <!-- HttpResilienceContextExtensions.GetRequestMessage is [Experimental] in the resilience
         package. The .NET 8 line of Microsoft.Extensions.Http.Resilience (8.10.0) has no
         DisableForUnsafeHttpMethods helper, so we mirror it at the ShouldHandle predicate
         and need the context fallback to avoid retrying unsafe methods on transient
         exceptions. The suppression is scoped to the one call site. -->
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LakeSpeak.Genie.Tests" />
    <InternalsVisibleTo Include="LakeSpeak.ContractTests" />
    <InternalsVisibleTo Include="LakeSpeak.LiveIntegrationTests" />
  </ItemGroup>

</Project>
