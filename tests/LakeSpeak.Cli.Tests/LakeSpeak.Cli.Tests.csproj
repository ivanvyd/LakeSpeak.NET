<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The CLI is net10.0-only (see ADR 0006), so the project that exercises it
         is too. The library family continues to multi-target, and the
         non-CLI test projects (Application, Genie, QuestionPacks, Contract,
         Live) inherit `net8.0;net10.0` from tests/Directory.Build.props. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="Spectre.Console.Testing" />
    <ProjectReference Include="..\..\src\LakeSpeak.Cli\LakeSpeak.Cli.csproj" />
    <ProjectReference Include="..\..\src\LakeSpeak.Rendering\LakeSpeak.Rendering.csproj" />
  </ItemGroup>

</Project>
